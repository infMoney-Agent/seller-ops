# Copy to a private path outside the repository on the production server,
# e.g. ~/.config/seller-ops-cd/seller.prod.env (chmod 600).
#
# Public HTTP IP entry (port 80 only; Casdoor admin stays loopback-only on 127.0.0.1:18000).
APP_HOST=159.75.9.75
# Required by base compose.yaml variable checks; overridden by compose.prod-http.yaml.
APP_DOMAIN=159.75.9.75
AUTH_DOMAIN=casdoor.internal

# Database passwords (generate 4 independent random hex strings: openssl rand -hex 24)
POSTGRES_PASSWORD=
APP_DB_PASSWORD=
AUTH_DB_PASSWORD=
SCREENING_DB_PASSWORD=

# Internal HMAC signing secrets (at least 32 bytes each: openssl rand -hex 32)
SCREENING_INTERNAL_SECRET=
ECOM_INTERNAL_SECRET=

# Casdoor OIDC credentials (fill after initial Casdoor bootstrap via SSH tunnel)
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=
CASDOOR_APPLICATION_NAME=application_seller_ops
OIDC_SHARED_APPLICATION=true
OIDC_DEFAULT_ORGANIZATION=built-in
PUBLIC_REGISTRATION_ENABLED=false

# Optional external model / proxy / Amazon Ads settings
# LLM_PROVIDER=openai
# OPENAI_API_KEY=
# OPENAI_BASE_URL=https://api.openai.com/v1
# OPENAI_MODEL=gpt-4o
# SCRAPER_PROXY_URL=

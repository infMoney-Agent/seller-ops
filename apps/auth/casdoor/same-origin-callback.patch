@@ -0,0 +1,13 @@
+// Only Casdoor's own callback endpoints belong to its social-login round trip.
+// Other applications may share the origin behind a reverse proxy.
+export function isIdentityCallback(redirectUri: string | null | undefined, serverUrl: string): boolean {
+ if (!redirectUri) return false;
+ try {
+  const target = new URL(redirectUri);
+  const server = new URL(serverUrl);
+  if (target.origin !== server.origin) return false;
+  const base = server.pathname.replace(/\/+$/, "");
+  const callback = base + "/callback";
+  return target.pathname === callback || target.pathname.startsWith(callback + "/") || target.pathname === base + "/api/callback";
+ } catch { return false; }
+}

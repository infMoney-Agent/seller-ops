+++ b/web/src/lib/organization-identity.ts
@@ -0,0 +1,7 @@
+// Identifiers are generated once when the add form opens; labels remain editable.
+export function newOrganizationIdentifier(): string {
+  const suffix = Array.from({length: 6}, () =>
+    String.fromCharCode(97 + Math.floor(Math.random() * 26)),
+  ).join("");
+  return `organization_${suffix}`;
+}

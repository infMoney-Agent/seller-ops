+test('base path own callback',()=>assert.equal(isIdentityCallback('https://identity.test/idp/callback','https://identity.test/idp'),true));
+test('base path client callback',()=>assert.equal(isIdentityCallback('https://identity.test/api/auth/callback','https://identity.test/idp'),false));
+test('invalid and missing callbacks',()=>{assert.equal(isIdentityCallback('invalid','https://identity.test'),false);assert.equal(isIdentityCallback(null,'https://identity.test'),false)});

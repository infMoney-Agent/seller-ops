+++ b/object/organization_identity.go
@@ -0,0 +1,11 @@
+package object
+
+import "fmt"
+
+// Organization names are identity keys shared with Seller Ops, not display names.
+func checkOrganizationNameImmutable(original, updated string) error {
+	if original != updated {
+		return fmt.Errorf("organization identifier cannot be changed; delete and create a new organization instead (组织标识创建后不可修改，请删除后新增；公司名称请修改显示名称)")
+	}
+	return nil
+}
diff --git a/object/organization_identity_test.go b/object/organization_identity_test.go
new file mode 100644
index 0000000..8d8b016
--- /dev/null
+++ b/object/organization_identity_test.go
@@ -0,0 +1,24 @@
+package object
+
+import "testing"
+
+func TestOrganizationNameImmutable(t *testing.T) {
+	for _, test := range []struct {
+		name, original, updated string
+		allowed                 bool
+	}{
+		{"same organization", "organization_abcdef", "organization_abcdef", true},
+		{"rename", "organization_abcdef", "organization_ghijkl", false},
+		{"clear", "organization_abcdef", "", false},
+		{"case change", "organization_abcdef", "organization_ABCDEF", false},
+		{"built-in unchanged", "built-in", "built-in", true},
+		{"built-in rename", "built-in", "other", false},
+	} {
+		t.Run(test.name, func(t *testing.T) {
+			err := checkOrganizationNameImmutable(test.original, test.updated)
+			if (err == nil) != test.allowed {
+				t.Fatalf("allowed=%t, error=%v", test.allowed, err)
+			}
+		})
+	}
+}

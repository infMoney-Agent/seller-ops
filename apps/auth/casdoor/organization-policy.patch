diff --git a/web/tests/organization-identity.test.mjs b/web/tests/organization-identity.test.mjs
new file mode 100644
index 0000000..5efc89d
--- /dev/null
+++ b/web/tests/organization-identity.test.mjs
@@ -0,0 +1,15 @@
+import assert from "node:assert/strict";
+import {test} from "node:test";
+import {newOrganizationIdentifier} from "../src/lib/organization-identity.ts";
+
+test("new identifiers use organization_ followed by exactly six lowercase letters", () => {
+  for (let i = 0; i < 1000; i++) {
+    assert.match(newOrganizationIdentifier(), /^organization_[a-z]{6}$/);
+  }
+});
+test("random boundaries remain lowercase letters", (t) => {
+  t.mock.method(Math, "random", () => 0);
+  assert.equal(newOrganizationIdentifier(), "organization_aaaaaa");
+  Math.random.mock.mockImplementation(() => 1 - Number.EPSILON);
+  assert.equal(newOrganizationIdentifier(), "organization_zzzzzz");
+});
